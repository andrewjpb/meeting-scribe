{
  "manifest_version": 3,
  "name": "LAP Reuniões — Quem fala no Meet e no Teams",
  "version": "0.1.1",
  "description": "Manda ao app LAP Reuniões, neste computador, os nomes de quem fala no Google Meet e no Microsoft Teams aberto no Chrome. Nada sai da máquina.",
  "host_permissions": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
