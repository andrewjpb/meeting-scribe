{
  "name": "@meeting-scribe/desktop",
  "productName": "Meeting Scribe",
  "version": "0.13.1",
  "private": true,
  "description": "App desktop do Meeting Scribe (Electron + React)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:aai": "node scripts/aai-live-test.mjs",
    "test:claude": "node scripts/claude-live-test.mjs",
    "pack": "bash scripts/pack.sh",
    "pack:linux": "bash scripts/pack-linux.sh"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.107.0",
    "@agentclientprotocol/sdk": "2.7.0",
    "imapflow": "2.12.1",
    "lucide-react": "1.72.0",
    "mailparser": "3.14.5",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
